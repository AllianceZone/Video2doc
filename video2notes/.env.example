# Copy this file to .env and fill in real values for your environment.
# Every setting here has a working default in config.py, so the service runs
# with zero config out of the box (SQLite + local filesystem storage + local
# LLM provider) -- override only what you need for your deployment.

# --- App ---
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string-in-production

# --- Database ---
# Local dev default: SQLite, no setup needed.
# DATABASE_URL=sqlite:///./video2notes.db
# Production: Postgres
DATABASE_URL=postgresql+psycopg2://video2notes:video2notes@localhost:5432/video2notes

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
# Set true to run Celery tasks synchronously in-process (no worker/Redis
# needed) -- handy for local dev and required for the test suite.
CELERY_TASK_ALWAYS_EAGER=false

# --- Object storage (MinIO for local dev; real S3 in production) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=video2notes
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
# If no S3 config is set at all, storage falls back to ./local_storage
USE_LOCAL_STORAGE_FALLBACK=true

# --- LLM ---
LLM_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Transcription ---
WHISPER_ENGINE=local
WHISPER_LOCAL_MODEL=medium
WHISPER_LOCAL_DEVICE=auto
WHISPER_LOCAL_COMPUTE_TYPE=auto
